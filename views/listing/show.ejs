<% layout("/layouts/boilerplate")%>
  <h3 class="text-center">
    <%= listing.title %>
  </h3>
  <div class="d-flex gap-4">
    <div>
      <img src="<%=listing.image %>" class="card-img-top" alt="listing-image" style="height: 70%" />
    </div>
    <div class="card-body">
      <div class="lists">
        <ul>
          <li><b>
              <%= listing.title %>
            </b></li>
          <li>
            <%= listing.description %>
          </li>
          <li>&#8377;<%= listing.price.toLocaleString("en-IN") %>/Night</li>
          <li>
            <%= listing.location %>
          </li>
          <li>
            <%= listing.country %>
          </li>
        </ul>
        <div class="d-flex ms-2 gap-2">
          <form action="/listing/<%=listing._id%>/edit">
            <button class="btn btn-outline-secondary card-link">Edit</button>
          </form>
          <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-outline-dark card-link">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="col-8 offset-2 mb-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing.id %>/review" method="post" class="needs-validation" novalidate>
      <div class="mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input class="form-range" type="range" class="form-control" max="5" min="1" id="rating" name="review[rating]"
          required />
      </div>
      <div class="mt-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea name="review[comment]" class="form-control" id="comment" rows="5" cols="30" class="form-control"
          required></textarea>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-outline-dark">Submit</button>
      </div>
    </form>
  </div>
  <div class="col-8 offset-2 mb-3">
    <hr>
    <h4>All Reviews</h4>
    <div class="row">
      <% for(review of listing.reviews) { %>
        <div class="card mb-3  col-5 p-2 ms-4">
          <div class="card-body">
            <h5 class="card-title">User_name</h5>
            <p class="card-text">
              <%= review.comment %>
            </p>
             <h6 class="card-subtitle mb-2 text-body-secondary"><%= review.rating %>⭐</h6>
          </div>
          <form method="post" class="mt-2 mb-2" action="/listings/<%=listing._id%>/review/<%=review._id%>?_method=DELETE">
            <button class="btn btn-outline-dark card-link btn-sm">Delete</button>
          </form>
        </div>
        <% } %>
    </div>
  </div>